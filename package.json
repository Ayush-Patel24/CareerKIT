{
  "name": "careerkit",
  "version": "1.0.0",
  "private": true,
  "description": "CareerKit — Complete AI Resume Builder & Career Assistant",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "start": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server:start\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
